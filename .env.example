# ---------------------------------------------------------------------------
# appbazaar.ai environment variables
# Copy to .env (and apps/registry/.env.local) and fill in for production.
# With NOTHING set, the stack runs fully locally on embedded PGlite.
# ---------------------------------------------------------------------------

# Database (Phase 1 + 3). When unset, an embedded PGlite instance is used.
# Production: Supabase Postgres — get from Dashboard → Project Settings →
# Database → Connection string. Use Session mode pooler (port 5432) for
# Next.js serverless; Transaction mode (port 6543) for Cloudflare Workers.
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Auth (human identity for the registry). When set, signed-in users
# are auto-mapped to tenants. Without these keys the registry uses a
# dev-cookie fallback so local dev works with zero config.
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# Routing layer (Phase 2)
PORT=8888
# Revenue split: platform fee in basis points (clamped to 500-1000 = 5%-10%).
PLATFORM_FEE_BPS=1000

# Where the registry tells agents the router lives (shown in connect snippets).
NEXT_PUBLIC_ROUTER_URL="http://localhost:8888"

# Used by the seed script + registry dev seeding to point the sample
# echo-connector listing at a running reference connector.
EXAMPLE_CONNECTOR_URL="http://localhost:8787"

# --- Production integrations (optional in MVP; seams are wired) -------------

# Upstash Redis (router pub/sub backplane on Cloudflare Workers).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Stripe Connect (creator payouts; manual in MVP).
# STRIPE_SECRET_KEY=
# STRIPE_CONNECT_CLIENT_ID=
