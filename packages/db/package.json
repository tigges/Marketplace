  },
  "dependencies": {
    "@appbazaar/core": "workspace:*",
    "@electric-sql/pglite": "^0.2.12",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
